# Security headers for assets served WITHOUT invoking the Worker.
#
# wrangler.jsonc sets `run_worker_first` to an array, so only /api/*, /t/*, /p/*,
# /admin/*, /j/*, /i/*, /og/t/* and /healthz reach worker/index.ts. Every other
# path -- including "/" and every _next chunk -- is served straight off the asset
# handler, and a header set in the Worker never runs for them.
#
# That is the right performance tradeoff (one Worker invocation per page view
# instead of fifteen), but it means the Worker cannot be the only place headers
# are set. This file covers the static path; worker/lib/headers.ts (W2) covers
# the dynamic one. Both must stay in agreement.
#
# No Content-Security-Policy here on purpose. The real policy is per-page and
# hash-based, built from worker/csp-hashes.json, because the theme-bootstrap
# script is inline and has to be allowed by hash. A single static CSP broad
# enough to cover every page would need 'unsafe-inline', which passes a scanner
# and stops nothing. W2 owns the real one.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Content-addressed filenames, so these can be cached hard and forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate. The launch page will be replaced by the real home page,
# and a stale immutable copy in a phone's cache is not something we can purge.
/
  Cache-Control: public, max-age=0, must-revalidate
